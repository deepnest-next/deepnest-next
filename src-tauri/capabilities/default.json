{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Workspace UI: native file dialogs, read/write of user-picked files, a small settings store and external links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "store:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
